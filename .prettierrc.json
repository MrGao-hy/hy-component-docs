{
    "printWidth": 100,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "proseWrap": "never",
    "htmlWhitespaceSensitivity": "ignore",
    "vueIndentScriptAndStyle": true,
    "overrides": [
        {
            "files": "*.md",
            "options": {
                "proseWrap": "never",
                "htmlWhitespaceSensitivity": "ignore"
            }
        },
        {
            "files": ["*.scss", "*.css"],
            "options": {
                "singleQuote": false
            }
        }
    ]
}
